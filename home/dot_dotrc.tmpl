function maybe_source() {
    # shellcheck disable=SC1090
    [ -z "$1" ] || [ ! -f "$1" ] || source "$1"
}

export PATH="{{ .path.path }}"
{{ if isExecutable .path.named.mise -}}
{{ output .path.named.mise "env" | trim }}
{{- end }}

maybe_source "{{ joinPath .path.local "etc/homebrew/env" }}
maybe_source "{{ joinPath .path.home ".config/op/plugins.sh" }}

