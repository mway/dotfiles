[user]
	name = Matt Way
	{{- if .personal }}
	email = mway@mway.id
	{{- else }}
	email = mway@groq.com
	{{- end }}
[github]
	user = mway
[color]
	ui = auto
[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green
[color "diff"]
	meta = yellow bold
	frag = magenta bold
	old = red
	new = green
[color "status"]
	added = yellow
	changed = green
	untracked = cyan
[help]
	autocorrect = 1
[push]
	default = current
	followTags = true
[diff]
	colorMoved = default
	relative = true
	renames = copies
[core]
	editor = hx
	excludesfile = ~/.gitignore
	pager = delta
[interactive]
	diffFilter = delta --color-only --features=interactive
[delta]
	dark = true
    features = decorations
	line-numbers = true
	navigate = true
	syntax-theme = Dracula
[delta "interactive"]
	keep-plus-minus-markers = false
[delta "line-numbers"]
	line-numbers-left-style = cyan
	line-numbers-right-style = cyan
	line-numbers-minus-style = 124
	line-numbers-plus-style = 28
[delta "decorations"]
    commit-decoration-style = blue ol
	commit-style = raw
	file-style = omit # bold yellow ul
	hunk-header-decoration-style = blue
	hunk-header-style = file line-number
[merge]
	conflictstyle = diff3
[mergetool]
	keepBackup = true
[alias]
	unstaged = "!f() { git --no-pager diff --name-only "$@"; }; f"
	staged = "!f() { git --no-pager diff --name-only --cached "$@"; }; f"
	changed = "!f() { git --no-pager show --pretty="" --name-only "$@"; }; f"
	untracked = "!f() { git --no-pager ls-files . --exclude-standard --others "$@"; }; f"
	amend = commit --amend
	amendq = commit --amend -C HEAD
	am = amend
	co = checkout
	cascade = flow --cascade
	l = log --pretty=oneline -n 20 --graph --abbrev-commit
	lg = log --graph --pretty=format:'%C(bold red)%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
	s = status --short --branch
	ec = edit-changed
	eu = edit-unstaged
	du = diff-unstaged
	au = add-unstaged
	cb = change-branch
	ds = diff --staged
	fadd = fuzzy-add
	fdiff = fuzzy-diff
	current-branch = symbolic-ref --short HEAD
	curbranch = current-branch
	cur = current-branch
	upstream = "!f() { git rev-parse --abbrev-ref "${1:-"HEAD"}"@{upstream}; }; f"
	parent = upstream
	branch-commit = "!f() { git l "$1" | head -n1; }; f"
	bc = branch-commit
	tags = tag -l
	sshow = "!f() { git stash show stash^{/$*} -p; }; f"
	sapply = "!f() { git stash apply stash^{/$*}; }; f"
	spop = "!f() { git stash pop stash^{/$*}; }; f"
	show-files = show --pretty="format:" --name-only
	pr-and-merge = "!f() { git pr && git merge-pr; }; f"
	pr-merge = "merge-pr"
	prm = pr-and-merge
	create-release = "!f() { release create --notes="$1" --title="$1" "$1" && git fetch -t; }; f"
	commit-msg = "!f() { git log --format="%B" -n 1 | perl -pe 'chomp if eof'; }; f"
	msg = commit-msg
[branch]
	autosetuprebase = always
[rerere]
	enabled = true
[http "https://gopkg.in"]
	followRedirects = true
[url "ssh://git@github.com/mway/"]
	insteadOf = https://github.com/mway/
[credential]
	helper = osxkeychain
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[init]
	defaultBranch = main
[farc "upload"]
	add-repo-prefix = false
[merge]
	stat = false
[rebase]
	stat = false
[pager]
	branch = false
[remote "origin"]
	fetch = +refs/heads/mway/*:refs/remotes/origin/mway/*
	tagOpt = --no-tags
[url "ssh://git@github.com/uber/"]
	insteadOf = https://github.com/uber/
{{ if not .personal -}}
[url "ssh://git@github.com/groq/"]
	insteadOf = https://github.com/groq/
{{- end }}
