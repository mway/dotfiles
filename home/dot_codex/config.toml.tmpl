version = 1
model = "gpt-5.1-codex-max"
notify = []
profile = "default"
model_reasoning_effort = "high"
model_reasoning_summary = "detailed"
model_verbosity = "medium"

[features]
apply_patch_freeform = true
view_image_tool = true
web_search_request = true
unified_exec = false
rmcp_client = false
experimental_sandbox_command_assessment = false
ghost_commit = false
experimental_windows_sandbox = false
enable_elevated_windows_sandbox = false

[history]
persistence = "save-all"
max_bytes = 10485760

[profiles.default]
provider = "openai"
model = "gpt-5.2-codex"
model_reasoning_effort = "high"
personality = "pragmatic"

[profiles.default.model_options]
temperature = 0.35
top_p = 1.0
max_output_tokens = 32000

[profiles.default.persona]
tone = "concise"
style = "friendly"

[profiles.default.prompts]
system = """
You are a coding agent running in the Codex CLI. Be concise, precise, and safe.
"""
developer = """
Read both @~/AGENTS.md and @AGENTS.md, if they exist, and internalize their instructions. Make minimal, targeted changes. Use apply_patch for edits.
"""

[profiles.default.tools.shell]
enabled = true
default_timeout_ms = 120000
read_max_lines = 250
prefer_rg = true

[profiles.default.tools.shell.policy]
allow_read_only_in_workspace = true
allowed_commands = [
  "rg", "grep", "fd", "find", "ls", "tree", "cat", "bat", "head", "tail",
  "sed", "awk", "sort", "uniq", "cut", "wc", "stat", "file", "strings",
  "jq", "yq", "env", "printenv", "git", "go", "cargo", "python", "node",
]

[profiles.default.tools.shell.policy.allowed_subcommands]
git = ["status", "log", "show", "diff", "blame", "describe", "rev-parse", "branch", "tag"]
go = ["list", "env", "test", "vet"]
cargo = ["check", "metadata"]

[profiles.default.tools.apply_patch]
enabled = true
confirm_before_write = true

[profiles.default.tools.update_plan]
enabled = true
auto_show = true

[profiles.default.sandbox]
filesystem = "workspace-write" # read-only | workspace-write | danger-full-access
network = "enabled"            # restricted | enabled
approvals = "on-request"       # untrusted | on-failure | on-request | never

[profiles.default.safety]
confirm_destructive = true
block_gui_commands = true
require_confirmation_for_non_allowlisted_commands = true

[profiles.default.ui]
preamble_on_tool_calls = true
progress_updates = true
suppress_repo_trust_prompt = true

[profiles.default.paths]
workspace_root = "."
ignore = [".git/**", "node_modules/**", "vendor/**", "dist/**"]

[profiles.default.auth]
env = "OPENAI_API_KEY"

[profiles.default.telemetry]
enabled = false

[profiles.read_only]
provider = "openai"
model = "gpt-5.1-codex-max"

[profiles.read_only.sandbox]
filesystem = "read-only"
network = "enabled"
approvals = "untrusted"

[profiles.full_auto]
provider = "openai"
model = "gpt-5.1-codex-max"

[profiles.full_auto.sandbox]
filesystem = "danger-full-access"
network = "enabled"
approvals = "never"

[profiles.methodical]
provider = "openai"
model = "gpt-5.2-codex"
model_reasoning_effort = "high"

[profiles.methodical.model_options]
temperature = 0.35
top_p = 1.0
max_output_tokens = 32000

[profiles.methodical.persona]
tone = "analytical"
style = "detailed"

[profiles.methodical.prompts]
system = """
You are a coding agent running in the Codex CLI with extreme attention to detail.
"""
developer = """
Read both @~/AGENTS.md and @AGENTS.md, if they exist, and internalize their instructions. Operate with hyper-detailed, evidence-based reasoning. Show your work and reasoning at each step.
"""

[profiles.concise]
provider = "openai"
model = "gpt-5.2-codex"
model_reasoning_effort = "medium"
model_verbosity = "low"

[profiles.concise.model_options]
temperature = 0.35
top_p = 1.0
max_output_tokens = 32000

[profiles.concise.persona]
tone = "concise"
style = "direct"

[profiles.concise.prompts]
system = """
You are a coding agent running in the Codex CLI. Be extremely concise and action-focused.
"""
developer = """
Read both @~/AGENTS.md and @AGENTS.md, if they exist, and internalize their instructions. Minimize verbosity. Focus on action over explanation unless explicitly asked.
"""

[profiles.reviewer]
provider = "openai"
model = "gpt-5.2-codex"
model_reasoning_effort = "high"

[profiles.reviewer.model_options]
temperature = 0.35
top_p = 1.0
max_output_tokens = 32000

[profiles.reviewer.persona]
tone = "analytical"
style = "detailed"

[profiles.reviewer.prompts]
system = """
You are a code review specialist running in the Codex CLI.
"""
developer = """
Read both @~/AGENTS.md and @AGENTS.md, if they exist, and internalize their instructions. Focus on thorough, interactive code review. Be pedantic and detail-oriented.
"""

[profiles.reviewer.sandbox]
filesystem = "read-only"
network = "enabled"
approvals = "on-request"

[profiles.security]
provider = "openai"
model = "gpt-5.2-codex"
model_reasoning_effort = "high"

[profiles.security.model_options]
temperature = 0.35
top_p = 1.0
max_output_tokens = 32000

[profiles.security.persona]
tone = "analytical"
style = "detailed"

[profiles.security.prompts]
system = """
You are a security auditing specialist running in the Codex CLI.
"""
developer = """
Read both @~/AGENTS.md and @AGENTS.md, if they exist, and internalize their instructions. Focus on identifying security vulnerabilities, runtime safety issues, and potential exploits.
"""

[profiles.security.sandbox]
filesystem = "read-only"
network = "enabled"
approvals = "on-request"

# MCP servers
#[mcp_servers.github]
#command = "github-mcp-server"
#args = ["stdio"]

[mcp_servers.astgrep]
command = "ast-grep-server"
args = []

[mcp_servers.gopls]
command = "gopls"
args = ["mcp"]

{{- if (stat (joinPath .chezmoi.homeDir "bin/rust-analyzer-mcp-codex")) }}
[mcp_servers.rust]
command = "rust-analyzer-mcp-codex"
args = []
{{- end }}

[mcp_servers.time]
command = "mcp-server-time"
args = ["--local-timezone", "America/New_York"]

[mcp_servers.playwright]
command = "mcp-server-playwright"
args = []

[mcp_servers.apple-reminders]
command = "mcp-server-apple-events"
args = []

[notice]
hide_gpt5_1_migration_prompt = true
"hide_gpt-5.1-codex-max_migration_prompt" = true

[notice.model_migrations]
"gpt-5.1-codex-max" = "gpt-5.2-codex"
