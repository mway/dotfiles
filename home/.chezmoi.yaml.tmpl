{{- $globalCache := "1" -}}
{{- $personal := and (lt (len .chezmoi.hostname) 15) (ne .chezmoi.hostname .chezmoi.username) -}}
{{- $localRoot := print .chezmoi.homeDir "/.local" -}}
{{- $localBin := print $localRoot "/bin" -}}
{{- $localEtc := print $localRoot "/etc" }}
{{- $localShare := print $localRoot "/share" }}
{{- $localVar := print $localRoot "/var" }}
{{- $localLog := print $localRoot "/log" }}
{{- $userHome := .chezmoi.homeDir -}}
{{- $userBin := print $userHome "/bin" }}
{{- $userConfig := print $userHome "/.config" -}}
{{- $goPath := print $userHome "/go" -}}
{{- $goPathBin := print $goPath "/bin" -}}
{{- $goRoot := print $localRoot "/go" -}}
{{- $goRootBin := print $goRoot "/bin" -}}
{{- $cargoHome := print $userHome "/.cargo" -}}
{{- $cargoBin := print $cargoHome "/bin" -}}
{{- $userPythonBin := print (trim (output "python3" "-m" "site" "--user-base")) "/bin" -}}
{{- $pathFragments := list }}
{{- if eq .chezmoi.os "darwin" -}}
{{-   $pathFragments = list $userBin $localBin $cargoBin $goPathBin $goRootBin $userPythonBin "/opt/homebrew/sbin" "/opt/homebrew/bin" "/usr/local/sbin" "/usr/local/bin" }}
{{- else -}}
{{-   $pathFragments = list $userBin $localBin $cargoBin $goPathBin $goRootBin $userPythonBin "/usr/local/sbin" "/usr/local/bin" }}
{{- end -}}
{{- $computedPath := join ":" (uniq (concat $pathFragments (splitList ":" (env "PATH")))) -}}

diff:
  command: "difft"
  exclude:
    - scripts
git:
  autoCommit: false

data:
  user: {{ .chezmoi.username }}
  shell: {{ trim (output "which" "zsh") }}
  personal: {{ $personal }}
  cache:
    global: {{ $globalCache }}

  arch: {{ .chezmoi.arch }}
  os: {{ .chezmoi.os }}

  path:
    cargo: {{ $cargoHome }}
    config: {{ $userConfig }}
    gopath: {{ $goPath }}
    goroot: {{ $goRoot }}
    home: {{ $userHome }}
    local: {{ $localRoot }}
    path: {{ $computedPath }}
    profiled: {{ joinPath $userHome ".profile.d" }}

    named:
      cargoBin: {{ $cargoBin }}
      goBin: {{ $goPathBin }}
      gorootBin: {{ $goRootBin }}
      localBin: {{ $localBin }}
      localLog: {{ $localLog }}
      localShare: {{ $localShare }}
      localVar: {{ $localVar }}
      mise: {{ joinPath $userBin "mise" }}
      userBin: {{ $userBin }}

  versions:
    ansi: "2c84a541a31d68a4d2779fbfb37a56fca29da4ab"
    bat: "0.25.0"
    bazelisk: "1.25.0"
    btop: "1.3.1"
    chezmoi: "2.60.1"
    clang: "19.1.7"
    ctop: "0.7.7"
    delta: "0.18.2"
    difftastic: "0.63.0"
    direnv: "2.35.0"
    dirfmt: "0.2.0"
    ensure: "0.5.0"
    eza: "0.20.20"
    fasd: "1.0.1"
    fd: "10.2.0"
    ffmpeg: "7.1.1"
    fzf: "v0.60.3"
    gh: "2.68.1"
    git: "2.47.2"
    git_flow: "0.9.0"
    go: "1.24.1"
    golangci_lint: "1.64.5"
    golangci_lint_langserver: "0.0.10"
    gopls: "0.18.1"
    helix: "25.01.1"
    helix_check: "25.01.1"
    jq: "1.7.1"
    just: "1.40.0"
    lefthook: "1.11.3"
    mise: "v2025.3.2"
    mockgen: "0.5.0"
    ninja: "1.12.1"
    pre_commit: "4.2.0"
    ripgrep: "14.1.1"
    rustup: "1.27.1"
    shfmt: "3.10.0"
    sourcegraph: "6.1.0"
    staticcheck: "2025.1"
    yq: "4.44.3"
    yt_dlp: "2025.02.19"
    zellij: "0.41.2"
