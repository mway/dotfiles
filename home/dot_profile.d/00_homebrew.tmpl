#!/usr/bin/env bash
# Managed by Chezmoi

export HOMEBREW_GITHUB_API_TOKEN={{ quote (onepasswordRead "op://infra/homebrew/token") }}

_homebrew_bin="/opt/homebrew/bin"
_homebrew_sbin="/opt/homebrew/bin"

case ":$PATH:" in
*":$_homebrew_sbin:"*) ;;
*) export PATH="${PATH}:${_homebrew_sbin}" ;;
esac

case ":$PATH:" in
*":$_homebrew_bin:"*) ;;
*) export PATH="${PATH}:${_homebrew_bin}" ;;
esac

if command -v brew >/dev/null 2>&1; then
  eval "$(brew shellenv)"
fi
