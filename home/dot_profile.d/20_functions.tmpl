#!/usr/bin/env bash

notify-filter() {
  local interval="${1:-}" # seconds; empty = notify-once
  local interval_ms=""
  local last_beep_ms=0
  local beeped_once=0
  local now_ms=0

  if [ -n "$interval" ]; then
    interval_ms="$(
      python3 - "$interval" <<'PY'
import sys

try:
    value = float(sys.argv[1])
except (ValueError, IndexError):
    print("notify-filter: interval must be numeric", file=sys.stderr)
    sys.exit(1)

if value < 0:
    print("notify-filter: interval must be non-negative", file=sys.stderr)
    sys.exit(1)

print(int(value * 1000))
PY
    )" || return 1
  fi

  while IFS= read -r line; do
    printf '%s\n' "$line"

    if [ -z "$interval" ]; then
      if [ "$beeped_once" -eq 0 ]; then
        printf '\a'
        beeped_once=1
      fi
    else
      now_ms=$(python3 -c 'import time; print(int(time.time() * 1000))') || return 1

      if [ $((now_ms - last_beep_ms)) -ge "$interval_ms" ]; then
        printf '\a'
        last_beep_ms=$now_ms
      fi
    fi
  done
}

alphagen() {
  local args=("${@:-32}")
  pwgen -s -c -0 -1 -r "\!\\#\"'\`" "${args[@]}" | tr -d '\n'
}

alphanumgen() {
  local args=("${@:-32}")
  pwgen -s -c -n -1 -r "\!\\#\"'\`" "${args[@]}" | tr -d '\n'
}

strgen() {
  local args=("${@:-64}")
  pwgen -s -c -n -y -1 -r "\!\\#\"'\`" "${args[@]}" | tr -d '\n'
}
