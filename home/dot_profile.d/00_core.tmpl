#!/usr/bin/env bash
# Managed by Chezmoi

# Sane history
export HISTCONTROL=ignoreboth:erasedups
export HISTSIZE=100000000
shopt -u histappend 2>/dev/null

# $EDITOR/etc
export VISUAL="hx"
export EDITOR="$VISUAL"
export LESS="-R --mouse"

# Terminal settings
export LS_COLORS='di=38;5;108:fi=00:*svn-commit.tmp=31:ln=38;5;116:ex=38;5;186'
export TERM="xterm-256color"

# Tools
export ANSIBLE_NOCOWS=1

if command -v bat >/dev/null 2>&1; then
  export MANPAGER="sh -c 'col -bx | bat -l man -p'"
fi

# Miscellaneous
export BASH_SILENCE_DEPRECATION_WARNING=1

# Paths
export PATH="${HOME}/bin:${HOME}/.local/bin:${PATH}"

# Core aliases
alias ansi-error-custom="ansi-badge 160 88"
alias ansi-error="ansi-error-custom ERROR"
alias ansi-important-custom="ansi-badge 129 54"
alias ansi-important="ansi-important-custom IMPORTANT"
alias ansi-info-custom="ansi-badge 33 25"
alias ansi-info="ansi-info-custom INFO"
alias ansi-ok-custom="ansi-badge 34 22"
alias ansi-ok="ansi-ok-custom OK"
alias ansi-warning-custom="ansi-badge 208 130"
alias ansi-warning="ansi-warning-custom WARNING"
