#!/usr/bin/env bash
# Managed by Chezmoi

# Sane history
export HISTCONTROL=ignoreboth:erasedups
export HISTSIZE=100000000
shopt -u histappend 2>/dev/null

# $EDITOR/etc
export VISUAL="hx"
export EDITOR="$VISUAL"
export LESS="-R --mouse"

# Terminal settings
export LS_COLORS='di=38;5;108:fi=00:*svn-commit.tmp=31:ln=38;5;116:ex=38;5;186'
export TERM="xterm-256color"

# Tools
export ANSIBLE_NOCOWS=1

if command -v bat >/dev/null 2>&1; then
  export MANPAGER="sh -c 'col -bx | bat -l man -p'"
fi

# Miscellaneous
export BASH_SILENCE_DEPRECATION_WARNING=1

# Paths
export PATH="${HOME}/bin:${HOME}/.local/bin:${PATH}"

# Core aliases
alias ansi-badge-blue="ansi-badge 33 25"
alias ansi-badge-cyan="ansi-badge 30 23"
alias ansi-badge-green="ansi-badge 34 22"
alias ansi-badge-grey="ansi-badge 240 237"
alias ansi-badge-magenta="ansi-badge 162 89"
alias ansi-badge-orange="ansi-badge 208 130"
alias ansi-badge-purple="ansi-badge 129 54"
alias ansi-badge-red="ansi-badge 160 88"
alias ansi-debug="ansi-badge-grey DEBUG"
alias ansi-error="ansi-badge-red ERROR"
alias ansi-important="ansi-badge-purple IMPORTANT"
alias ansi-info="ansi-badge-blue INFO"
alias ansi-ok="ansi-badge-green OK"
alias ansi-warning="ansi-badge-orange WARNING"

_ansi_badges=(blue cyan green grey magenta orange purple red)
_ansi_named_badges=(debug error important info ok warning)
alias ansi-badge-list-all='for b in "${_ansi_badges[@]}"; do echo "ansi-badge-${b}"; done; for b in "${_ansi_named_badges[@]}"; do echo "ansi-${b}"; done'
