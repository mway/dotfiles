#!/usr/bin/env zsh

export ZSH="$HOME/.oh-my-zsh"

export FZF_BASE="{{ joinPath .path.local "share/fzf" }}"
[ ! -f "${FZF_BASE}/shell/key-bindings.zsh" ] || source "${FZF_BASE}/shell/key-bindings.zsh"
[ ! -f "${FZF_BASE}/shell/completion.zsh" ] || source "${FZF_BASE}/shell/completion.zsh"

export MISE="{{ .path.named.mise }}"
[ ! -f "$MISE" ] || eval "$("$MISE" activate zsh)"

ZSH_THEME="dracula"
HIST_STAMPS="yyyy-mm-dd"

plugins=(
  bazel
  direnv
  fasd
  fd
  fzf
  gitfast
  gpg-agent
  golang
  keychain
  ripgrep
  rust
  z
)

setopt HIST_EXPIRE_DUPS_FIRST
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_FIND_NO_DUPS
setopt HIST_SAVE_NO_DUPS
setopt EXTENDED_HISTORY
setopt INC_APPEND_HISTORY
export HISTTIMEFORMAT="[%F %T] "
export HISTSIZE=100000000
export LANG=en_US.UTF-8

sources=(
  "$ZSH/oh-my-zsh.sh"
  '{{ joinPath .path.home ".dotrc" }}'
  '{{ joinPath .path.home ".dotrc.zsh" }}'
  '{{ joinPath .path.home ".dotrc.local" }}'
)

for src in "${sources[@]}"; do
  [ ! -f "$src" ] || source "$src"
done
