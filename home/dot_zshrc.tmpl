#!/usr/bin/env zsh
# Managed by chezmoi

autoload -U +X compinit && compinit
autoload -U colors && colors

ZSH_THEME="dracula"
HIST_STAMPS="yyyy-mm-dd"
setopt HIST_EXPIRE_DUPS_FIRST
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_FIND_NO_DUPS
setopt HIST_SAVE_NO_DUPS
setopt EXTENDED_HISTORY
setopt INC_APPEND_HISTORY
setopt interactivecomments
export HISTTIMEFORMAT="[%F %T] "
export HISTSIZE=100000000
export LANG=en_US.UTF-8
export ZSH="{{ .path.home }}/.oh-my-zsh"

export MISE="{{ .path.named.mise }}"
[ ! -f "$MISE" ] || eval "$("$MISE" activate zsh)"

{{ if .personal -}}
export PATH="$PATH:{{ joinPath .path.home ".cache/lm-studio/bin" }}"
[ -s "{{ .path.home }}/.bun/_bun" ] && source "{{ .path.home }}/.bun/_bun"
{{ else -}}
eval "$(test -x hermit && hermit shell-hooks --print --zsh)"
source "{{ joinPath .path.config "groq-bootstrap/groq-bootstrap.zsh" }}"
{{- end }}

sources=(
  '{{ joinPath .path.home ".dotrc" }}'
  '{{ joinPath .path.home ".dotrc.zsh" }}'
  '{{ joinPath .path.home ".dotrc.local" }}'
  "$ZSH/oh-my-zsh.sh"
)
for src in "${sources[@]}"; do
  [ ! -f "$src" ] || source "$src"
done

eval "$(fzf --zsh)"
eval "$(just --completions zsh)"

plugins=(
  bazel
  direnv
  fasd
  fzf
  gitfast
  gpg-agent
  golang
  homebrew
  keychain
  rust
  z
)
