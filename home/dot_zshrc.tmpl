#!/usr/bin/env zsh
# Managed by chezmoi

autoload -U +X compinit && compinit
autoload -U colors && colors
autoload -U select-word-style && select-word-style bash

setopt EXTENDED_HISTORY
setopt HIST_EXPIRE_DUPS_FIRST
setopt HIST_FIND_NO_DUPS
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_SAVE_NO_DUPS
setopt INC_APPEND_HISTORY
setopt interactivecomments
export HISTSIZE=100000000

BREW=/opt/homebrew/bin/brew
[ ! -f "$BREW" ] || eval "$("$BREW" shellenv)"

MISE="{{ .path.named.mise }}"
[ ! -f "$MISE" ] || eval "$("$MISE" activate zsh)"

! command -v fzf >/dev/null || eval "$(fzf --zsh)"
! command -v just >/dev/null || eval "$(just --completions zsh)"

sources=(
  '{{ joinPath .path.home ".dotrc" }}'
  '{{ joinPath .path.home ".dotrc.zsh" }}'
  '{{ joinPath .path.home ".dotrc.local" }}'
)
for src in "${sources[@]}"; do
  [ ! -f "$src" ] || source "$src"
done
