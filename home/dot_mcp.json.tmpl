{
  "mcpServers": {
    "ast-grep-mcp": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/ast-grep/ast-grep-mcp",
        "ast-grep-server"
      ]
    },
    "gopls": {
      "type": "stdio",
      "command": "gopls",
      "args": ["mcp"]
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "rust-analyzer-mcp": {
      "type": "stdio",
      "command": "rust-analyzer-mcp",
      "args": []
    },
    "notion": {
      "type": "http",
      "url": "https://mcp.notion.com/mcp"
    },
    "apple-reminders": {
      "type": "stdio",
      "command": "mcp-server-apple-events",
      "args": []
    }
  }
}
