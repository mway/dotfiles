#!/usr/bin/env bash

set -euo pipefail

_main() {
  local local_config="$HOME/.claude.local.json"
  local merged_config="$HOME/.claude.json"
  local shared_keys="$HOME/.config/claude/shared_keys.json"

  source "${HOME}/.profile.d/00_core"

  if ! which -as jq >/dev/null 2>&1; then
    ansi-badge-red "error" "'jq' not found in \$PATH"
    exit 1
  fi

  if ! [ -f "$merged_config" ]; then
    ansi-badge-red "error" "Live config not found (~/.claude.json); run 'claude' or 'chezmoi apply'"
    exit 1
  fi

  if ! [ -f "$shared_keys" ]; then
    ansi-badge-red "error" "Shared keys definition not found at ${shared_keys}; run 'chezmoi apply'"
    exit 1
  fi

  ansi-badge-blue "claude" "Syncing local keys from ~/.claude.json to ~/.claude.local.json"

  jq --slurpfile sharedKeys "$shared_keys" \
    'delpaths($sharedKeys[0] | map([.]))' \
    "$merged_config" >"$local_config"

  ansi-badge-green "claude" "Local state saved to ~/.claude.local.json"
}

_main "$@"
