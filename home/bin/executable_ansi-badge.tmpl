#!/usr/bin/env bash

set -euo pipefail

_main() {
  readonly hi="$1"
  readonly lo="$2"
  readonly badge="$3"
  readonly msg=("${@:4}")
  echo "$(ansi --bg-color="$hi" --white-intense --bold " ${badge} ")$(ansi --bg-color="$lo" --white-intense " ${msg[*]} ")"
}

_main "$@"
