version: 1
profiles:
  default:
    provider: openai  # or groq, local
    model: gpt-5
    model_options:
      temperature: 0.2
      top_p: 1.0
      max_output_tokens: 32000
    persona:
      tone: concise
      style: friendly
    prompts:
      system: |
        You are a coding agent running in the Codex CLI. Be concise, precise, and safe.
      developer: |
        Read both @~/AGENTS.md and @AGENTS.md, if they exist, and internalize their instructions. For Go code, always follow the Uber Go Style Guide. Follow repository style in the absence of other guidance. Make minimal, targeted changes. Use apply_patch for edits.
    tools:
      shell:
        enabled: true
        default_timeout_ms: 120000
        read_max_lines: 250
        prefer_rg: true
      apply_patch:
        enabled: true
      update_plan:
        enabled: true
        auto_show: true
    sandbox:
      filesystem: workspace-write   # read-only | workspace-write | danger-full-access
      network: restricted           # restricted | enabled
      approvals: on-request         # untrusted | on-failure | on-request | never
    safety:
      confirm_destructive: true
      block_gui_commands: true
    ui:
      preamble_on_tool_calls: true
      progress_updates: true
    paths:
      workspace_root: .
      ignore:
        - .git/**
        - node_modules/**
        - vendor/**
        - dist/**
    auth:
      env: OPENAI_API_KEY  # or GROQ_API_KEY
      # groq:  # alternatively
      #   api_key_env: GROQ_API_KEY
    telemetry:
      enabled: false
