---
default-model: deepseek
# Text to append when using the -f flag.
format-text:
  markdown: 'Format the response as markdown without enclosing backticks.'
  json: 'Format the response as json without enclosing backticks.'
# List of predefined system messages that can be used as roles.
roles:
  "default": []
  shell:
    - you are a shell expert
    - you do not explain anything
    - you simply output one liners to solve the problems you're asked
    - you do not provide any explanation whatsoever, ONLY the command
  coding:
    - you are a coding expert
    - read ~/.config/agent/AGENT.md and strictly adhere to its guidance
    - do not make filesystem modifications (including git commits) without prompting
  chooser:
    - you are selecting from a list of items
    - your output will be used programmatically
    - do not include additional formatting, whitespace, or non-option text
# Ask for the response to be formatted as markdown unless otherwise set.
format: false
# System role to use.
role: "default"
# Render output as raw text when connected to a TTY.
raw: false
# Quiet mode (hide the spinner while loading and stderr messages for success).
quiet: false
# Temperature (randomness) of results, from 0.0 to 2.0.
temp: 1.0
# TopP, an alternative to temperature that narrows response, from 0.0 to 1.0.
topp: 1.0
# TopK, only sample from the top K options for each subsequent token.
topk: 50
# Turn off the client-side limit on the size of the input into the model.
no-limit: false
# Wrap formatted output at specific width (default is 80)
word-wrap: 79
# Include the prompt from the arguments in the response.
include-prompt-args: false
# Include the prompt from the arguments and stdin, truncate stdin to specified number of lines.
include-prompt: 0
# Maximum number of times to retry API calls.
max-retries: 5
# Your desired level of fanciness.
fanciness: 10
# Text to show while generating.
status-text: Thinking
# Theme to use in the forms. Valid units are: 'charm', 'catppuccin', 'dracula', and 'base16'
theme: dracula
# Default character limit on input to model.
max-input-chars: 12250
# Maximum number of tokens in response.
# max-tokens: 100
# 
# max-completion-tokens: 100
# Aliases and endpoints for OpenAI compatible REST API.
apis:
  groq:
    base-url: https://api.groq.com/openai/v1
    api-key-env: GROQ_API_KEY
    models: # https://console.groq.com/docs/models
      deepseek-r1-distill-llama-70b:
        aliases: ["deepseek"]
        max-input-chars: 90112
        max-completion-tokens: 40960
      qwen-qwq-32b:
        aliases: ["qwen", "qwq", "qwen-qwq"]
        max-input-chars: 65536
        max-completion-tokens: 65536
      qwen/qwen3-32b:
        aliases: ["qwen3"]
        max-input-chars: 90112
        max-completion-tokens: 40960
      compound-beta:
        aliases: ["compound-beta"]
        max-input-chars: 122880
        max-completion-tokens: 8192
      compound-beta-mini:
        aliases: ["compound-beta-mini"]
        max-input-chars: 122880
        max-completion-tokens: 8192
      llama-3.1-8b-instant:
        aliases: ["llama31", "llama3.1", "llama3.1-8b", "llama3.1-instant"]
        max-input-chars: 65536
        max-completion-tokens: 65536
      llama-3.3-70b-versatile:
        aliases: ["llama33", "llama3.3", "llama3.3-70b", "llama3.3-versatile"]
        max-input-chars: 98304
        max-completion-tokens: 32768
      llama3-70b-8192:
        aliases: ["llama3", "llama3-70b"]
        max-input-chars: 4096
        max-completion-tokens: 4096
        fallback: llama3-8b-8192
      llama3-8b-8192:
        aliases: ["llama3-8b"]
        max-input-chars: 4096
        max-completion-tokens: 4096
      meta-llama/llama-4-maverick-17b-128e-instruct:
        aliases: ["llama-4-maverick-17b-128e-instruct", "maverick"]
        max-input-chars: 122880
        max-completion-tokens: 8192
      meta-llama/llama-4-scout-17b-16e-instruct:
        aliases: ["llama-4-scout-17b-16e-instruct", "scout"]
        max-input-chars: 122880
        max-completion-tokens: 8192
      gemma2-9b-it:
        aliases: ["gemma2"]
        max-input-chars: 4096
        max-completion-tokens: 4096
      mistral-saba-24b:
        aliases: ["mistral"]
        max-input-chars: 16384
        max-completion-tokens: 16384
  google:
    api-key-env: GEMINI_API_KEY
    models:
      gemini-2.5-pro:
        aliases: ["gemini", "gemini2.5", "gemini-pro"]
        max-input-chars: 1048576
        max-completion-tokens: 65536
      gemini-2.5-flash:
        aliases: ["flash", "gemini-flash"]
        max-input-chars: 1048576
        max-completion-tokens: 65536
  # ollama:
  #   base-url: http://localhost:11434/api
  #   models: # https://ollama.com/library
  #     "llama3.2:3b":
  #       aliases: ["llama3.2"]
  #       max-input-chars: 650000
  #     "llama3.2:1b":
  #       aliases: ["llama3.2_1b"]
  #       max-input-chars: 650000
  #     "llama3:70b":
  #       aliases: ["llama3"]
  #       max-input-chars: 650000
  # localai:
  #   # LocalAI setup instructions: https://github.com/go-skynet/LocalAI#example-use-gpt4all-j-model
  #   base-url: http://localhost:8080
  #   models:
  #     ggml-gpt4all-j:
  #       aliases: ["local", "4all"]
  #       max-input-chars: 12250
  #       fallback:
mcp-servers:
  fetch:
    command: "mcp-server-fetch"
    args: []
  filesystem:
    command: "mcp-server-filesystem"
    args:
      - "{{ .path.config }}/agent"
      - "{{ .path.home }}/go/src"
  git:
    command: "mcp-server-git"
    args: []
  github:
    command: "github-mcp-server"
    args: ["--enable-command-logging", "--read-only", "stdio"]
  memory:
    command: "mcp-server-memory"
    args: []
  sequential-thinking:
    command: "mcp-server-sequential-thinking"
    args: []
  time:
    command: "mcp-server-time"
    args: ["--local-timezone", "America/New_York"]
