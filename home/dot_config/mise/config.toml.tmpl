[env]
_.file = ".env"
_.source = [".envrc", ".envrc.local"]
GOTOOLCHAIN = "go{{ .versions.go }}"
JUST_UNSTABLE = 1

[settings]
auto_install = true
not_found_auto_install = true
experimental = true
jobs = 4

[tasks."go:build"]
run = "go build"
[tasks."go:test"]
run = "gotestsum -f dots -- -race -coverprofile cover.out -count 1"
[tasks."go:vtest"]
run = "go test -v -race -count 1 -coverprofile cover.out"
[tasks."go:cover:text"]
run = "go tool cover -func cover.out"
depends = ["go:test"]
[tasks."go:cover:html"]
run = "go tool cover -html cover.out"
depends = ["go:test"]
[tasks."go:lint"]
run = "golangci-lint run"
[tasks."go:lint-all"]
run = "golangci-lint run --new=false"
[tasks."go:fix"]
run = "golangci-lint run --fix"
[tasks."go:fix-all"]
run = "golangci-lint run --fix --new=false"

