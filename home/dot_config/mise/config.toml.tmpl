direnv = {{ quote .versions.direnv }}
fd = {{ quote .versions.fd }}
ffmpeg = {{ quote .versions.ffmpeg }}
fzf = {{ quote .versions.fzf }}
github-cli = {{ quote .versions.gh }}
glow = {{ quote .versions.glow }}
go = {{ quote .versions.go }}
gofumpt = {{ quote .versions.gofumpt }}
golangci-lint = {{ quote .versions.golangci_lint }}
golangci-lint-langserver = {{ quote .versions.golangci_lint_langserver }}
golines = {{ quote .versions.golines }}
gotestsum = {{ quote .versions.gotestsum }}
gum = {{ quote .versions.gum }}
helix = {{ quote .versions.helix }}
hurl = {{ quote .versions.hurl }}
jq = {{ quote .versions.jq }}
just = {{ quote .versions.just }}
mask = {{ quote .versions.mask }}
ninja = {{ quote .versions.ninja }}
node = {{ quote .versions.node }}
pipx = {{ quote .versions.pipx }}
pnpm = {{ quote .versions.pnpm }}
