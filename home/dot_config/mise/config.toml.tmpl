python = {{ quote .versions.python }}  # run mise settings python.compile=1 if issues
ripgrep = {{ quote .versions.ripgrep }}
shfmt = {{ quote .versions.shfmt }}
staticcheck = {{ quote .versions.staticcheck }}
terraform = {{ quote .versions.terraform }}
