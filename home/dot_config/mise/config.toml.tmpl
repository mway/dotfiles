zellij = {{ quote .versions.zellij }}

"cargo:bindgen-cli" = {{ quote .versions.bindgen }}
"cargo:cargo-expand" = {{ quote .versions.cargo_expand }}
"cargo:cbindgen" = {{ quote .versions.cbindgen }}
"cargo:difftastic" = {{ quote .versions.difftastic }}
"cargo:eza" = {{ quote .versions.eza }}
"cargo:gping" = {{ quote .versions.gping }}
"cargo:lsp-ai" = {{ quote .versions.lsp_ai }}
"cargo:lstr" = {{ quote .versions.lstr }}
"cargo:minijinja-cli" = {{ quote .versions.minijinja }}
"cargo:taplo-cli" = { version = {{ quote .versions.taplo }}, features = "lsp" }
"cargo:trippy" = {{ quote .versions.trippy }}

"go:github.com/github/github-mcp-server/cmd/github-mcp-server" = {{ quote .versions.github_mcp_server }}
"go:github.com/brandonyoungdev/tldx" = {{ quote .versions.tldx }}
"go:github.com/cashapp/hermit/cmd/hermit" = {{ quote .versions.hermit }}
"go:github.com/charmbracelet/mods" = {{ quote .versions.mods }}
"go:github.com/opencode-ai/opencode" = {{ quote .versions.opencode }}
"go:github.com/orlangure/gocovsh" = {{ quote .versions.gocovsh }}
"go:github.com/ymtdzzz/otel-tui" = {{ quote .versions.otel_tui }}
"go:go.mway.dev/dirfmt" = {{ quote .versions.dirfmt }}
"go:go.mway.dev/git/cmd/git-flow" = {{ quote .versions.git_flow }}
"go:go.uber.org/mock/mockgen" = {{ quote .versions.mockgen }}
"go:golang.org/x/perf/cmd/benchstat" = {{ quote .versions.benchstat }}
"go:golang.org/x/tools/cmd/benchcmp" = {{ quote .versions.benchcmp }}
"go:golang.org/x/tools/cmd/deadcode" = {{ quote .versions.deadcode }}
"go:golang.org/x/tools/cmd/goimports" = {{ quote .versions.goimports }}
"go:golang.org/x/tools/gopls" = {{ quote .versions.gopls }}

"npm:yaml-language-server" = {{ quote .versions.yaml_lsp }}
"npm:@modelcontextprotocol/server-filesystem" = "latest"
"npm:@modelcontextprotocol/server-memory" = "latest"
"npm:@modelcontextprotocol/server-sequential-thinking" = "latest"

"pipx:flake8" = {{ quote .versions.flake8 }}
"pipx:isort" = {{ quote .versions.isort }}
"pipx:jedi-language-server" = {{ quote .versions.jedi }}
"pipx:psf/black" = {{ quote .versions.black }}
"pipx:pyflakes" = {{ quote .versions.pyflakes }}
"pipx:pylint" = {{ quote .versions.pylint }}
"pipx:python-lsp-server" = {{ quote .versions.pylsp }}
"pipx:ruff" = {{ quote .versions.ruff }}

{{ if .personal -}}
# Personal
bazel = {{ quote .versions.bazel }}
lefthook = {{ quote .versions.lefthook }}
nomad = {{ quote .versions.nomad }}
yt-dlp = {{ quote .versions.yt_dlp }}
"go:go.mway.dev/ensure" = {{ quote .versions.ensure }}
"pipx:ansible" = { version = {{ quote .versions.ansible }}, uvx = "false", pipx_args = "--include-deps" }
{{- else -}}
# Groq
kubectl = "latest"
kubectx = "latest"
{{- end }}

[settings]
auto_install = true
not_found_auto_install = true
experimental = true
jobs = 4
