#!/usr/bin/env just --justfile
# Managed by chezmoi

default:
    @just --justfile {{ justfile() }} --list | grep -v default

todo PATH NAME=".+":
    rg -U '(//|#) TODO\({{ NAME }}\).+\n(\s+(//|#).+$)*' src/code.uber.internal/{{ PATH }}

###
# Go
###

[no-cd]
test +ARGS="./...":
    go test -race -failfast -count 1 -coverprofile cover.out -run . {{ ARGS }}

[no-cd]
vtest +ARGS="./...": (test "-v" ARGS)

[no-cd]
cover-html +ARGS="./...": (test ARGS)
    go tool cover -html cover.out

[no-cd]
cover-text +ARGS="./...": (test ARGS)
    go tool cover -func cover.out

[no-cd]
bench +ARGS="./...":
    go test -count 1 -run xxx -benchmem -bench . {{ ARGS }}

[no-cd]
vbench +ARGS="./...": (bench "-v" ARGS)

[no-cd]
lint +ARGS="./...":
    golangci-lint run --new=false {{ ARGS }}

[no-cd]
lint-fix +ARGS="./...": (lint "--fix" ARGS)

###
# HERMIT
###

[no-cd]
hermit-upgrade TOOL VERSION:
    #!/usr/bin/env bash
    set -euo pipefail
    hermit uninstall "{{ TOOL }}" || true
    hermit install "{{ TOOL }}-{{ VERSION }}"

###
# META HELPERS
###

[no-exit-message]
prompt-default-no MESSAGE CONTEXT="":
    #!/usr/bin/env bash
    while true; do
        echo -ne "$(ansi --yellow "{{ MESSAGE }}"){{ if CONTEXT != "" { "\n\n\t" + CONTEXT + "" } else { "" } }} [yN]: "
        read -p "" yn
        yn="$(echo "$yn" | tr '[:upper:]' '[:lower:]')"
        case $yn in
            y|yes)
                exit 0;
                ;;
            *)
                ansi --yellow "Canceled by user; aborting."
                exit 1;
                ;;
        esac
    done

[no-exit-message]
prompt-default-yes MESSAGE CONTEXT="":
    #!/usr/bin/env bash
    while true; do
        echo -ne "$(ansi --yellow "{{ MESSAGE }}"){{ if CONTEXT != "" { "\n\n\t" + CONTEXT + "" } else { "" } }} [Yn]: "
        read -p "" yn
        yn="$(echo "$yn" | tr '[:upper:]' '[:lower:]')"
        case $yn in
            n|no)
                ansi --yellow "Canceled by user; aborting."
                exit 1;
                ;;
            *)
                exit 0;
                ;;
        esac
    done

[no-exit-message]
prompt-run-command COMMAND:
    #!/usr/bin/env bash
    set -euo pipefail
    command="$(ansi --red "{{ COMMAND }}" | fold -s -w 60 | tr '\n' '\r' | sed -e 's#\r#\\\\\n\t\t#g')"
    command="${command::-4}"
    just prompt-default-no "Run the following command?" "${command}\n\nResponse"
