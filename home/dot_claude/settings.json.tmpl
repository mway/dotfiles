{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Edit(**)",
      "Glob",
      "Grep",
      "LS",
      "MultiEdit(**)",
      "Read(**)",
      "WebFetch",
      "WebSearch",
      "Write(**)",

      "Bash(ast-grep :*)",
      "Bash(basename :*)",
      "Bash(bat :*)",
      "Bash(black :*)",
      "Bash(cargo :*)",
      "Bash(cat :*)",
      "Bash(clang-format :*)",
      "Bash(command :*)",
      "Bash(date :*)",
      "Bash(diff :*)",
      "Bash(direnv :*)",
      "Bash(dirname :*)",
      "Bash(echo :*)",
      "Bash(eza :*)",
      "Bash(false)",
      "Bash(fd :*)",
      "Bash(file :*)",
      "Bash(find :*)",
      "Bash(gh :*)",
      "Bash(git :*)",
      "Bash(go :*)",
      "Bash(gofumpt :*)",
      "Bash(golangci-lint :*)",
      "Bash(golines :*)",
      "Bash(grep :*)",
      "Bash(head :*)",
      "Bash(isort :*)",
      "Bash(jq :*)",
      "Bash(just :*)",
      "Bash(ls :*)",
      "Bash(make :*)",
      "Bash(man :*)",
      "Bash(mask :*)",
      "Bash(mise :*)",
      "Bash(prettier :*)",
      "Bash(pwd)",
      "Bash(realpath :*)",
      "Bash(rg :*)",
      "Bash(ruff :*)",
      "Bash(rustc :*)",
      "Bash(rustfmt :*)",
      "Bash(sg :*)",
      "Bash(shfmt :*)",
      "Bash(sort :*)",
      "Bash(stat :*)",
      "Bash(tail :*)",
      "Bash(taplo :*)",
      "Bash(terraform :*)",
      "Bash(test :*)",
      "Bash(tree :*)",
      "Bash(true)",
      "Bash(type :*)",
      "Bash(uniq :*)",
      "Bash(wc :*)",
      "Bash(which :*)",
      "Bash(xq :*)",
      "Bash(yq :*)"
    ],
    "deny": [
      "Bash(> :*)",
      "Bash(brew remove :*)",
      "Bash(brew uninstall :*)",
      "Bash(chmod :*)",
      "Bash(chown :*)",
      "Bash(curl :*)",
      "Bash(env)",
      "Bash(env :*)",
      "Bash(git add :*)",
      "Bash(git checkout :*)",
      "Bash(git clean :*)",
      "Bash(git commit :*)",
      "Bash(git merge :*)",
      "Bash(git push :*)",
      "Bash(git rebase :*)",
      "Bash(git reset :*)",
      "Bash(git restore :*)",
      "Bash(git stash apply :*)",
      "Bash(git stash branch :*)",
      "Bash(git stash clear)",
      "Bash(git stash drop :*)",
      "Bash(git stash pop :*)",
      "Bash(git stash push :*)",
      "Bash(git stash save :*)",
      "Bash(git stash)",
      "Bash(git switch :*)",
      "Bash(git tag :*)",
      "Bash(kill :*)",
      "Bash(killall :*)",
      "Bash(mv :*)",
      "Bash(npm uninstall :*)",
      "Bash(pip uninstall :*)",
      "Bash(printenv :*)",
      "Bash(pkill :*)",
      "Bash(rm :*)",
      "Bash(rmdir :*)",
      "Bash(su :*)",
      "Bash(sudo :*)",
      "Bash(wget :*)",
      "Read(.env*)",
      "Read(**/.env*)",
      "Read(**/*key*)",
      "Read(**/*password*)",
      "Read(**/*secret*)",
      "Read(**/*token*)",
      "Read(secrets/**)"
    ]
  },
  "model": "opusplan",
  "mcpServers": {
    "ast-grep-mcp": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/ast-grep/ast-grep-mcp",
        "ast-grep-server"
      ]
    },
    "gopls": {
      "type": "stdio",
      "command": "gopls",
      "args": ["mcp"]
    },
    "github": {
      "type": "stdio",
      "command": "github-mcp-server",
      "args": ["stdio"]
    },
    "rust-analyzer-mcp": {
      "type": "stdio",
      "command": "rust-analyzer-mcp",
      "args": []
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "command": "claude-post-tool-use"
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "printf '%s @ %s' \"$(git branch --show-current 2>/dev/null || echo 'no-git')\" \"$(pwd)\""
  }
}
