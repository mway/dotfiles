  "model": "opusplan",
  "installMethod": "native",
  "mcpServers": {
    "ast-grep-mcp": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/ast-grep/ast-grep-mcp",
        "ast-grep-server"
      ]
    },
    "gopls": {
      "type": "stdio",
      "command": "gopls",
      "args": ["mcp"]
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/"
    },
    "rust-analyzer-mcp": {
      "type": "stdio",
      "command": "rust-analyzer-mcp",
      "args": []
    },
    "notion": {
      "type": "http",
      "url": "https://mcp.notion.com/mcp"
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": {
          "tools": ["Edit", "Write", "MultiEdit"]
        },
        "hooks": [
          {
            "type": "command",
            "command": "claude-post-tool-use"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "printf '%s @ %s' \"$(git branch --show-current 2>/dev/null || echo 'no-git')\" \"$(pwd)\""
  }
}
