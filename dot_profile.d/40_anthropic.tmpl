#!/usr/bin/env bash
# Managed by Chezmoi

claude() {
  local has_model=0
  for arg in "$@"; do
    case "$arg" in
    "--model" | "--model"*)
      has_model=1
      ;;
    *)
      # nop
      ;;
    esac
  done

  local model=""
  if [[ $has_model -eq 0 ]]; then
    model="--model=opusplan"
  fi

  command claude \
    --allow-dangerously-skip-permissions \
    $model "$@"
}

claude-resume() {
  claude -c
}

claude-force-resume() {
  local generate=1
  local -a extra_args=()

  for arg in "$@"; do
    case "$arg" in
    "-r" | "--resume" | "--session-id")
      generate=0
      ;;
    *)
      # nop
      ;;
    esac
  done

  if [[ "$generate" -eq 1 ]]; then
    # shellcheck disable=SC2155
    local sid="$(uuidgen | tr '[:upper:]' '[:lower:]')"
    extra_args=(--session-id="$sid")
  fi

  claude "${extra_args[@]}" "$@"
}
