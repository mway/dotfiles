#!/usr/bin/env bash

set -euo pipefail

# Source mise environment to ensure tools are in PATH
if [[ -x "$HOME/bin/mise" ]]; then
    eval "$("$HOME/bin/mise" env -s bash)"
fi

source "${HOME}/.profile.d/00_core"

# Verify tool exists before using it
if ! command -v just >/dev/null; then
    ansi-error "just not found - cannot generate completions"
    exit 1
fi

ansi-badge-blue "  just" "Writing shell completion scripts"
base="${JUST_BASE:-"{{ joinPath .path.local "share/just" }}"}"
mkdir -p "${base}/completions"
just --completions zsh >>"${base}/completions/just.zsh"
just --completions bash >>"${base}/completions/just.bash"
